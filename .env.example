OPENAI_API_KEY=replace-with-server-side-openai-api-key

# Postgres connection string (e.g. Neon). Leave unset locally to use the embedded dev database.
DATABASE_URL=

# One code shared with every workshop participant
WORKSHOP_ACCESS_CODE=choose-a-workshop-code

# Admin-only code; do not share with participants
ADMIN_ACCESS_CODE=choose-a-different-admin-code

# Random string (32+ chars) used to sign session cookies
SESSION_SECRET=replace-with-a-long-random-string